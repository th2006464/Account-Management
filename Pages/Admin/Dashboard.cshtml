@page "/Admin/Dashboard"
@model AccountManagement.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "仪表盘";
}

@if (!Model.IsAuthenticated)
{
    <div class="alert alert-danger" style="margin-top: 20px;">请先<a asp-page="/Admin/Login">登录</a>。</div>
    return;
}

@if (!string.IsNullOrEmpty(Model.DashboardError))
{
    <div class="alert alert-danger">@Model.DashboardError</div>
}
else
{

@* 总览卡片 *@
<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
    @{var cs="flex:1;min-width:120px;text-align:center;margin-bottom:0;";}
    @{var bs="padding:10px 8px;";var h="font-size:22px;margin:0;";}
    <a asp-page="/Admin/Report" style="text-decoration:none;"><div class="panel panel-primary" style="@cs"><div class="panel-body" style="@bs"><div style="@h;color:#337ab7;">@Model.TotalUsers</div><small style="color:#666;">用户总数</small></div></div></a>
    <a asp-page="/Admin/Report" style="text-decoration:none;"><div class="panel panel-success" style="@cs"><div class="panel-body" style="@bs"><div style="@h;color:#5cb85c;">@Model.EnabledUsers</div><small style="color:#666;">启用用户</small></div></div></a>
    <a asp-page="/Admin/Report" style="text-decoration:none;"><div class="panel panel-danger" style="@cs"><div class="panel-body" style="@bs"><div style="@h;color:#d9534f;">@Model.DisabledUsers</div><small style="color:#666;">禁用用户</small></div></div></a>
    <a asp-page="/Admin/UserAdmin" style="text-decoration:none;"><div class="panel panel-warning" style="@cs"><div class="panel-body" style="@bs"><div style="@h;color:#f0ad4e;">@Model.LockedUsers</div><small style="color:#666;">锁定用户</small></div></div></a>
    <a asp-page="/Admin/Request" style="text-decoration:none;"><div class="panel panel-info" style="@cs"><div class="panel-body" style="@bs"><div style="@h;color:#5bc0de;">@Model.PendingRequests</div><small style="color:#666;">待处理</small></div></div></a>
</div>

@* 今日操作 + 密码到期 *@
<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
    <div class="panel panel-default" style="flex:1;min-width:240px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>今日操作</strong></div>
        <div class="panel-body" style="padding:8px;">
            <div style="display:flex;gap:8px;">
                <div style="flex:1;text-align:center;border-right:1px solid #eee;"><strong style="font-size:18px;color:#5cb85c;">@Model.TodayResets</strong><br/><small style="color:#999;">密码重置</small></div>
                <div style="flex:1;text-align:center;border-right:1px solid #eee;"><strong style="font-size:18px;color:#d9534f;">@Model.TodayOffboards</strong><br/><small style="color:#999;">离职处理</small></div>
                <div style="flex:1;text-align:center;"><strong style="font-size:18px;color:#337ab7;">@Model.TodayCreates</strong><br/><small style="color:#999;">创建用户</small></div>
            </div>
        </div>
    </div>
    <div class="panel panel-default" style="flex:1;min-width:240px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>密码到期预警</strong></div>
        <div class="panel-body" style="padding:8px;">
            <div style="display:flex;gap:8px;">
                <a asp-page="/Admin/Report" asp-route-expiry="7" style="flex:1;text-align:center;border-right:1px solid #eee;text-decoration:none;display:block;"><strong style="font-size:18px;color:#d9534f;">@Model.Expire7Days</strong><br/><small style="color:#999;">7天内</small></a>
                <a asp-page="/Admin/Report" asp-route-expiry="30" style="flex:1;text-align:center;border-right:1px solid #eee;text-decoration:none;display:block;"><strong style="font-size:18px;color:#f0ad4e;">@Model.Expire30Days</strong><br/><small style="color:#999;">30天内</small></a>
                <a asp-page="/Admin/Report" asp-route-expiry="60" style="flex:1;text-align:center;text-decoration:none;display:block;"><strong style="font-size:18px;color:#337ab7;">@Model.Expire60Days</strong><br/><small style="color:#999;">60天内</small></a>
            </div>
        </div>
    </div>
</div>

@* OU分布 + 7日趋势 *@
<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
    <div class="panel panel-default" style="flex:1;min-width:280px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>OU 用户分布</strong></div>
        <div class="panel-body" style="padding:8px 12px;">
            @foreach (var os in Model.OuStats)
            {
                <div style="margin-bottom:6px;">
                    <div style="display:flex;justify-content:space-between;margin-bottom:1px;font-size:12px;"><strong>@os.Label</strong><span>@os.Total 人 (@os.Percentage.ToString("F1")%)</span></div>
                    <div class="progress" style="margin-bottom:0;height:16px;"><div class="progress-bar" style="width:@os.Percentage.ToString("F0")%;min-width:30px;line-height:16px;font-size:11px;">@os.Total 人</div></div>
                </div>
            }
        </div>
    </div>
    <div class="panel panel-default" style="flex:1;min-width:280px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>&#128338; 7日密码更新人数</strong></div>
        <div class="panel-body" style="padding:4px 8px;">
            @if (Model.WeeklyTrends.Count > 0)
            {
                int maxVal = Model.WeeklyTrends.Max(t => t.Resets);
                if (maxVal == 0) { maxVal = 1; }
                <table style="width:100%;font-size:11px;">
                    @foreach (var t in Model.WeeklyTrends)
                    {
                        <tr><td style="width:38px;padding:1px 0;">@t.Date</td><td style="padding:1px 3px;"><div class="progress" style="margin:0;height:14px;background:#eee;"><div class="progress-bar progress-bar-success" style="width:@(100.0*t.Resets/maxVal)%;min-width:18px;line-height:14px;font-size:10px;">@t.Resets 人</div></div></td></tr>
                    }
                </table>
            }
        </div>
    </div>
</div>

@* 运营数据 + 入职统计 *@
<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
    <div class="panel panel-default" style="flex:1;min-width:220px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>&#128202; 运营数据</strong></div>
        <div class="panel-body" style="padding:6px 12px;">
            <table style="width:100%;font-size:12px;">
                <tr><td style="padding:2px 0;color:#666;">30天密码重置（管理员）</td><td style="text-align:right;"><strong>@Model.Recent30Resets</strong> 次</td></tr>
                <tr><td style="padding:2px 0;color:#666;">30天密码修改（自助）</td><td style="text-align:right;"><strong>@Model.Recent30SelfResets</strong> 次</td></tr>
                <tr><td style="padding:2px 0;color:#666;">入职申请总数</td><td style="text-align:right;"><strong>@Model.TotalOnboardRequests</strong> 条</td></tr>
                <tr><td style="padding:2px 0;color:#666;">禁用用户占比</td><td style="text-align:right;"><strong>@(Model.TotalUsers > 0 ? (100.0 * Model.OuDisabledUsers / Model.TotalUsers).ToString("F1") : "0")%</strong></td></tr>
            </table>
        </div>
    </div>
    <div class="panel panel-default" style="flex:1;min-width:220px;">
        <div class="panel-heading" style="padding:6px 12px;"><strong>&#128200; 最近30日入职人数</strong></div>
        <div class="panel-body" style="padding:6px 12px;">
            <strong style="font-size:22px;color:#337ab7;">@Model.Recent30NewUsers <small style="font-size:13px;color:#999;">人</small></strong>
            @foreach (var os in Model.NewUserByOu)
            {
                <div style="margin-bottom:4px;margin-top:4px;">
                    <div style="display:flex;justify-content:space-between;font-size:12px;"><span>@os.Label</span><span>@os.Total 人</span></div>
                    <div class="progress" style="margin:1px 0 0;height:14px;"><div class="progress-bar progress-bar-info" style="width:@os.Percentage.ToString("F0")%;min-width:18px;line-height:14px;font-size:10px;">@os.Total</div></div>
                </div>
            }
        </div>
    </div>
</div>

}
