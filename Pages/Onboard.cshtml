@page "/onboard"
@model AccountManagement.Pages.OnboardModel
@{
    ViewData["Title"] = "GARCHINA员工入职IT账号申请";
}

<div style="max-width: 50%; margin: 0 auto;">

<div class="alert alert-success" style="text-align: center; margin-top: 20px;">
    <h2 style="margin-top: 0; margin-bottom: 8px;">GARCHINA员工入职IT账号申请</h2>
    填写以下信息提交，管理员审批后将自动创建账号
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert alert-success" style="white-space: pre-line;">@Model.ResultMessage</div>
}

<form method="post" id="mainForm">
    <div class="panel panel-info">
        <div class="panel-heading"><strong>当前申请人</strong></div>
        <div class="panel-body">
            <div class="form-group">
                <label for="ContactEmail">信息回传邮箱地址</label>
                <input class="form-control" id="ContactEmail" name="ContactEmail" value="@Model.ContactEmail" placeholder="输入邮箱地址用于接收审批结果" autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="panel panel-default" style="margin-top: 10px;">
        <div class="panel-heading"><strong>员工信息</strong></div>
        <div class="panel-body">
            <div class="form-group">
                <label for="CnName">中文名 *</label>
                <input class="form-control" id="CnName" name="CnName" value="@Model.CnName" placeholder="如 张三丰" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="EnName">英文名 * (格式: Sanfeng.Zhang)</label>
                <input class="form-control" id="EnName" name="EnName" value="@Model.EnName" placeholder="如 Sanfeng.Zhang" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="EmployeeId">员工编号 * (8位数字)</label>
                <input class="form-control" id="EmployeeId" name="EmployeeId" value="@Model.EmployeeId" maxlength="8" placeholder="输入8位员工号" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="Mobile">手机号</label>
                <input class="form-control" id="Mobile" name="Mobile" value="@Model.Mobile" placeholder="输入手机号" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="Region">员工所属区域</label>
                <input class="form-control" id="Region" name="Region" value="@Model.Region" placeholder="华东销售 / 咸阳工厂 / 宁波食品" autocomplete="off" />
            </div>
            <div class="form-group">
                <label for="NeedEmail">是否申请邮箱</label>
                <select class="form-control" id="NeedEmail" name="NeedEmail" onchange="toggleManagerEmail()">
                    <option>否</option>
                    <option>是</option>
                </select>
            </div>
            <div class="form-group" id="managerEmailGroup" style="display: none;">
                <label for="ManagerEmail">直接上级邮箱地址</label>
                <input class="form-control" id="ManagerEmail" name="ManagerEmail" value="@Model.ManagerEmail" placeholder="输入直接上级邮箱" autocomplete="off" />
            </div>
            <div style="display: flex; gap: 20px;">
                <button type="submit" class="btn btn-success">提交账号申请</button>
                <button type="button" class="btn btn-default" style="margin-left: auto;" onclick="this.form.reset(); document.getElementById('managerEmailGroup').style.display='none';">清空内容</button>
            </div>
        </div>
    </div>
</form>

<script>
function toggleManagerEmail() {
    var sel = document.getElementById('NeedEmail');
    var group = document.getElementById('managerEmailGroup');
    group.style.display = sel.value === '是' ? 'block' : 'none';
}
(function() {
    var form = document.getElementById('mainForm');
    var submitting = false;
    form.addEventListener('submit', function(e) {
        if (submitting) { e.preventDefault(); return false; }
        submitting = true;
        setTimeout(function() {
            form.querySelectorAll('button[type="submit"]').forEach(function(b) { b.disabled = true; });
        }, 0);
        setTimeout(function() { submitting = false; }, 5000);
    });
})();
</script>
</div>
