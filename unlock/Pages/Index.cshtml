@page
@model Unlock.Pages.IndexModel
@{
    ViewData["Title"] = "AD 用户查询与解锁";
}

<div class="alert alert-success" style="text-align: center; margin-top: 20px;">
    <h2 style="margin-top: 0; margin-bottom: 8px;">AD 用户查询与解锁</h2>
    查询 GARCHINA / Sinarmas 域用户信息，自动检测并解锁锁定账号<br />
    此页面部署于域控，无需登录
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert alert-success">@Model.ResultMessage</div>
}

<form method="post" id="mainForm">
    <div class="panel panel-default">
        <div class="panel-heading" style="padding:6px 12px;"><strong>查询并解锁用户</strong></div>
        <div class="panel-body" style="padding:8px 12px;">
            <div class="form-group" style="margin-bottom:10px;">
                <input class="form-control" id="SearchEmployeeId" name="SearchEmployeeId" value="@Model.SearchEmployeeId" placeholder="输入员工号" autocomplete="off" />
            </div>
            <div style="display:flex;gap:8px;">
                <button type="submit" name="domain" value="garchina" class="btn btn-success" style="flex:1;">查询 GARCHINA 账号</button>
                <button type="submit" name="domain" value="sinarmas" class="btn btn-primary" style="flex:1;">查询 Sinarmas 账号</button>
            </div>
        </div>
    </div>
</form>

@* 查询等待提示 *@
<div id="waitingMsgGarchina" class="alert alert-info" style="display:none;margin-top:8px;">
    &#9203; 正在查询 GARCHINA 域，请耐心等待...
</div>
<div id="waitingMsgSinarmas" class="alert alert-info" style="display:none;margin-top:8px;">
    &#9203; Sinarmas 域跨域查询因线路问题可能需要<strong>30秒</strong>左右，请耐心等待返回结果...
</div>

@if (!string.IsNullOrEmpty(Model.UserDetail))
{
    <div class="panel panel-success" style="margin-top:8px;">
        <div class="panel-heading" style="padding:6px 12px;">@Model.ResultDomain 用户详细信息</div>
        <div class="panel-body" style="padding:8px 12px;">
            <pre style="margin:0;font-size:12px;">@Model.UserDetail</pre>
        </div>
    </div>
}

<script>
(function() {
    var form = document.getElementById('mainForm');
    var submitting = false;

    form.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && e.target.tagName !== 'BUTTON') {
            e.preventDefault();
        }
    });

    form.addEventListener('submit', function(e) {
        if (submitting) {
            e.preventDefault();
            return false;
        }
        submitting = true;
        // 根据点击的按钮显示对应提示
        var clickedBtn = e.submitter;
        if (clickedBtn && clickedBtn.value === 'sinarmas') {
            document.getElementById('waitingMsgSinarmas').style.display = 'block';
        } else {
            document.getElementById('waitingMsgGarchina').style.display = 'block';
        }
        var btns = form.querySelectorAll('button[type="submit"]');
        setTimeout(function() { btns.forEach(function(b) { b.disabled = true; }); }, 0);
        setTimeout(function() { submitting = false; btns.forEach(function(b) { b.disabled = false; }); }, 60000);
    });
})();
</script>
