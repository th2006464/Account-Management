@page "/Admin/Config"
@model AccountManagement.Pages.Admin.ConfigModel
@{
    ViewData["Title"] = "配置管理";
}

@if (!Model.IsAuthenticated)
{
    <div class="alert alert-danger">请先<a asp-page="/Admin/Login">登录</a>。</div>
    return;
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert alert-success">@Model.ResultMessage</div>
}

<div class="panel panel-default" style="margin-top:8px;">
    <div class="panel-heading" style="padding:6px 12px;"><strong>配置管理</strong></div>
    <div class="panel-body" style="padding:12px;">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label>更新左上角 Logo</label>
                <div style="margin-bottom:8px;">
                    <img src="~/logo.png?t=@DateTime.Now.Ticks" alt="当前Logo" style="max-width:200px;max-height:80px;border:1px solid #ddd;padding:4px;" onerror="this.style.display='none'" />
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <input type="file" name="logoFile" accept="image/*" class="form-control" style="max-width:350px;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">上传更新</button>
                </div>
                <small style="color:#999;">支持 PNG/JPG/GIF，最大 2MB，建议尺寸 200×60 像素</small>
            </div>
        </form>
    </div>
</div>

<div class="panel panel-default" style="margin-top:8px;">
    <div class="panel-heading" style="padding:6px 12px;"><strong>管理员授权</strong></div>
    <div class="panel-body" style="padding:8px 12px;">
        <form method="post">
            <div style="display:flex;gap:8px;margin-bottom:8px;">
                <input class="form-control" name="addAdminId" maxlength="8" placeholder="输入8位员工号" style="flex:1;" autocomplete="off" />
                <button type="submit" name="action" value="addAdmin" class="btn btn-success btn-sm">添加管理员</button>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
                <span style="line-height:1.8;margin-right:6px;font-size:12px;">当前管理员：</span>
                @if (Model.AdminList != null)
                {
                    foreach (var admin in Model.AdminList)
                    {
                        if (admin == "15005035")
                        {
                            <span class="btn btn-default btn-xs" style="pointer-events:none;opacity:0.7;">@admin</span>
                        }
                        else
                        {
                            <button type="submit" name="action" value="removeAdmin" class="btn btn-default btn-xs" onclick="document.getElementsByName('removeAdminId')[0].value='@admin';" title="点击移除">@admin ✕</button>
                        }
                    }
                }
            </div>
            <input type="hidden" name="removeAdminId" value="" />
        </form>
    </div>
</div>

@* 邮箱配置面板 *@
<div class="panel panel-info" style="margin-top:8px;">
    <div class="panel-heading" style="padding:6px 12px;"><strong>邮箱通知配置</strong></div>
    <div class="panel-body" style="padding:8px 12px;">
        <form method="post">
            <input type="hidden" name="action" value="saveEmailConfig" />

            @* SMTP 设置 *@
            <fieldset style="border:1px solid #ddd;padding:10px 15px;margin-bottom:12px;">
                <legend style="font-size:14px;font-weight:bold;margin-bottom:0;border:none;width:auto;padding:0 5px;">SMTP 服务器设置</legend>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <div class="form-group" style="flex:2;min-width:200px;margin-bottom:4px;">
                        <label style="font-size:12px;">服务器地址</label>
                        <input class="form-control input-sm" name="SmtpServer" value="@Model.EmailConfig.SmtpServer" placeholder="mail.example.com" />
                    </div>
                    <div class="form-group" style="flex:1;min-width:80px;margin-bottom:4px;">
                        <label style="font-size:12px;">端口</label>
                        <input class="form-control input-sm" name="SmtpPort" type="number" value="@Model.EmailConfig.SmtpPort" />
                    </div>
                    <div class="form-group" style="flex:2;min-width:200px;margin-bottom:4px;">
                        <label style="font-size:12px;">发件人地址</label>
                        <input class="form-control input-sm" name="FromAddress" value="@Model.EmailConfig.FromAddress" placeholder="it@company.com" />
                    </div>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    <div class="form-group" style="flex:2;min-width:200px;margin-bottom:0;">
                        <label style="font-size:12px;">SMTP 用户名</label>
                        <input class="form-control input-sm" name="SmtpUsername" value="@Model.EmailConfig.Username" placeholder="user@company.com" />
                    </div>
                    <div class="form-group" style="flex:2;min-width:200px;margin-bottom:0;">
                        <label style="font-size:12px;">SMTP 密码（留空不修改）</label>
                        <input class="form-control input-sm" name="SmtpPassword" type="password" placeholder="留空则不修改" autocomplete="new-password" />
                    </div>
                </div>
            </fieldset>

            @* 通知类型收件配置 *@
            <fieldset style="border:1px solid #ddd;padding:10px 15px;margin-bottom:12px;">
                <legend style="font-size:14px;font-weight:bold;margin-bottom:0;border:none;width:auto;padding:0 5px;">通知收件人配置（每类可独立设置，多地址用逗号分隔）</legend>
                <table style="width:100%;font-size:12px;">
                    <tr style="border-bottom:1px solid #eee;">
                        <th style="padding:4px 6px;width:16%;">通知类型</th>
                        <th style="padding:4px 6px;width:42%;">收件人 (To)</th>
                        <th style="padding:4px 6px;width:42%;">抄送 (Cc)</th>
                    </tr>
                    @{
                        var notifyKeys = new[] { "SelfPasswordChange", "AdminPasswordReset", "BatchPasswordReset", "NewUserCreate", "OnboardRequest", "OnboardApproval" };
                        var notifyLabels = new Dictionary<string, string>
                        {
                            ["SelfPasswordChange"] = "自助密码修改",
                            ["AdminPasswordReset"] = "管理员密码重置",
                            ["BatchPasswordReset"] = "批量密码重置",
                            ["NewUserCreate"] = "新用户创建",
                            ["OnboardRequest"] = "入职申请通知",
                            ["OnboardApproval"] = "入职审批通知",
                        };
                    }
                    @foreach (var key in notifyKeys)
                    {
                        var target = Model.EmailConfig.Notifications.GetValueOrDefault(key) ?? new AccountManagement.Models.EmailNotifyTarget();
                        <tr style="border-bottom:1px solid #f5f5f5;">
                            <td style="padding:4px 6px;vertical-align:middle;"><strong>@(notifyLabels.GetValueOrDefault(key, key))</strong></td>
                            <td style="padding:4px 6px;">
                                <input class="form-control input-sm" name="NotifyTo[@key]" value="@target.To" placeholder="如 admin@company.com" style="font-size:12px;" />
                            </td>
                            <td style="padding:4px 6px;">
                                <input class="form-control input-sm" name="NotifyCc[@key]" value="@target.Cc" placeholder="如 cc@company.com" style="font-size:12px;" />
                            </td>
                        </tr>
                    }
                </table>
            </fieldset>

            <button type="submit" class="btn btn-success btn-sm">保存邮箱配置</button>
        </form>
    </div>
</div>
