<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GARCHINA 账户管理</title>
    <link rel="stylesheet" href="https://apps.bdimg.com/libs/bootstrap/3.3.4/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AccountManagement.styles.css" asp-append-version="true" />
    <style>
        body { margin: 0; padding: 0; background: #f5f5f5; }
        .sidebar {
            position: fixed; top: 0; left: 0; width: 220px; height: 100vh;
            background: #fff; color: #333; overflow-y: auto; z-index: 1000;
            border-right: 1px solid #e0e0e0; box-shadow: 2px 0 8px rgba(0,0,0,0.05);
            display: flex; flex-direction: column;
        }
        .sidebar .logo-area { padding: 20px 15px; text-align: center; border-bottom: 1px solid #eee; flex-shrink: 0; }
        .sidebar .logo-area img { max-width: 180px; width: 100%; margin-bottom: 8px; }
        .sidebar .logo-area h4 { margin: 0; font-size: 14px; color: #333; font-weight: 600; }
        .sidebar .user-area { padding: 12px 15px; border-bottom: 1px solid #eee; font-size: 12px; color: #666; flex-shrink: 0; }
        .sidebar .nav-area { padding: 8px 0; flex: 1; }
        .sidebar .nav-area a {
            display: block; padding: 11px 20px; color: #555; text-decoration: none;
            font-size: 14px; transition: all 0.15s; border-left: 3px solid transparent;
        }
        .sidebar .nav-area a:hover { background: #f0f4f8; color: #337ab7; border-left-color: #337ab7; }
        .sidebar .nav-area a.active { background: #e8f0fe; color: #337ab7; font-weight: 600; border-left-color: #337ab7; }
        .sidebar .nav-area a .glyphicon { margin-right: 8px; font-size: 13px; color: #888; }
        .sidebar .nav-area a:hover .glyphicon, .sidebar .nav-area a.active .glyphicon { color: #337ab7; }
        .sidebar .logout-area { padding: 12px 15px; border-top: 1px solid #eee; flex-shrink: 0; }
        .sidebar .logout-area a { color: #888; font-size: 12px; }
        .sidebar .logout-area a:hover { color: #d9534f; text-decoration: none; }
        .main-content { margin-left: 220px; padding: 20px 25px; min-height: 100vh; }
        @@media (max-width: 768px) { .sidebar { width: 100%; height: auto; position: relative; } .main-content { margin-left: 0; } }
    </style>
</head>
<body>
    @{
        var isLoggedIn = Context.Session.GetString("AdminLoggedIn") == "true";
        var empId = Context.Session.GetString("AdminEmployeeId");
        var displayName = Context.Session.GetString("AdminDisplayName") ?? empId;
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
        var currentPath = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";

        // 未登录且不在登录页时自动跳转
        if (!isLoggedIn && !currentPage.Contains("Login"))
        {
            var loginUrl = $"{Context.Request.PathBase}/Admin/Login?returnUrl={System.Net.WebUtility.UrlEncode(currentPath)}";
            Context.Response.Redirect(loginUrl);
        }
    }
    @if (isLoggedIn)
    {
    <div class="sidebar">
        <div class="logo-area">
            <a asp-page="/Admin/UserAdmin"><img src="~/logo.png" alt="Logo" onerror="this.style.display='none'" style="border:0;" /></a>
            <h4>GARCHINA 账户管理系统</h4>
        </div>
        <div class="user-area">
            <div><span class="glyphicon glyphicon-user"></span> @displayName</div>
        </div>
        <div class="nav-area">
            <a asp-page="/Admin/UserAdmin" class="@(currentPage.Contains("UserAdmin") ? "active" : "")"><span class="glyphicon glyphicon-search"></span> 账号查询管理</a>
            <a asp-page="/Admin/Dashboard" class="@(currentPage.Contains("Dashboard") ? "active" : "")"><span class="glyphicon glyphicon-dashboard"></span> 系统仪表盘</a>
            <a asp-page="/Admin/Report" class="@(currentPage.Contains("Report") ? "active" : "")"><span class="glyphicon glyphicon-list-alt"></span> 用户统计表</a>
            @{
    var pendingCount = 0;
    try { var all = AccountManagement.Pages.OnboardModel.LoadAllRequests(); pendingCount = all.Count(r => r.Status == null); } catch { }
}
<a asp-page="/Admin/Request" class="@(currentPage.Contains("Request") ? "active" : "")"><span class="glyphicon glyphicon-ok-circle"></span> 等待创建用户 @if(pendingCount>0){<span class="badge" style="background:#d9534f;margin-left:4px;">@pendingCount</span>}</a>
            <a asp-page="/Admin/NewUser" class="@(currentPage.Contains("NewUser") ? "active" : "")"><span class="glyphicon glyphicon-plus"></span> 手动创建用户</a>
            <a asp-page="/Admin/BatchUser" class="@(currentPage.Contains("BatchUser") ? "active" : "")"><span class="glyphicon glyphicon-th-list"></span> 批量用户管理</a>
            <a asp-page="/Admin/SinarmasUser" class="@(currentPage.Contains("SinarmasUser") ? "active" : "")"><span class="glyphicon glyphicon-globe"></span> Sinarmas用户查询</a>
            <a href="https://www.garchina.com/ams" target="_blank"><span class="glyphicon glyphicon-hdd"></span> 资产信息查询</a>
        </div>
        <div class="logout-area" style="display:flex;justify-content:space-between;">
            <a asp-page="/Admin/Config"><span class="glyphicon glyphicon-cog"></span></a>
            <a asp-page="/Admin/Login" asp-page-handler="Logout"><span class="glyphicon glyphicon-log-out"></span> 退出登录</a>
        </div>
    </div>
    }
    <div class="main-content" style="@(isLoggedIn ? "" : "margin-left: 0;")">
        @RenderBody()
    </div>

    <script src="https://apps.bdimg.com/libs/jquery/2.1.4/jquery.min.js"></script>
    <script src="https://apps.bdimg.com/libs/bootstrap/3.3.4/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
