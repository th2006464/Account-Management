@page "/Admin/Config"
@model AccountManagement.Pages.Admin.ConfigModel
@{
    ViewData["Title"] = "配置管理";
}

@if (!Model.IsAuthenticated)
{
    <div class="alert alert-danger">请先<a asp-page="/Admin/Login">登录</a>。</div>
    return;
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="alert alert-success">@Model.ResultMessage</div>
}

<div class="panel panel-default" style="margin-top:8px;">
    <div class="panel-heading" style="padding:6px 12px;"><strong>配置管理</strong></div>
    <div class="panel-body" style="padding:12px;">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label>更新左上角 Logo</label>
                <div style="margin-bottom:8px;">
                    <img src="~/logo.png?t=@DateTime.Now.Ticks" alt="当前Logo" style="max-width:200px;max-height:80px;border:1px solid #ddd;padding:4px;" onerror="this.style.display='none'" />
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <input type="file" name="logoFile" accept="image/*" class="form-control" style="max-width:350px;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="white-space:nowrap;">上传更新</button>
                </div>
                <small style="color:#999;">支持 PNG/JPG/GIF，最大 2MB，建议尺寸 200×60 像素</small>
            </div>
        </form>
    </div>
</div>

<div class="panel panel-default" style="margin-top:8px;">
    <div class="panel-heading" style="padding:6px 12px;"><strong>管理员授权</strong></div>
    <div class="panel-body" style="padding:8px 12px;">
        <form method="post">
            <div style="display:flex;gap:8px;margin-bottom:8px;">
                <input class="form-control" name="addAdminId" maxlength="8" placeholder="输入8位员工号" style="flex:1;" autocomplete="off" />
                <button type="submit" name="action" value="addAdmin" class="btn btn-success btn-sm">添加管理员</button>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
                <span style="line-height:1.8;margin-right:6px;font-size:12px;">当前管理员：</span>
                @if (Model.AdminList != null)
                {
                    foreach (var admin in Model.AdminList)
                    {
                        if (admin == "15005035")
                        {
                            <span class="btn btn-default btn-xs" style="pointer-events:none;opacity:0.7;">@admin</span>
                        }
                        else
                        {
                            <button type="submit" name="action" value="removeAdmin" class="btn btn-default btn-xs" onclick="document.getElementsByName('removeAdminId')[0].value='@admin';" title="点击移除">@admin ✕</button>
                        }
                    }
                }
            </div>
            <input type="hidden" name="removeAdminId" value="" />
        </form>
    </div>
</div>
